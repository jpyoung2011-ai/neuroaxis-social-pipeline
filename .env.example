# --- Canva Connect API (Developer Portal integration) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Filled in automatically by setup_canva_oauth.py the first time you run it.
# NOTE: Canva rotates this on every use. In CI the pipeline logs the new value;
# update the GitHub secret when it changes (or run setup_canva_oauth.py again).
CANVA_REFRESH_TOKEN=
# The brand template you tagged for autofill (from canva.com/design/<ID>/...)
CANVA_BRAND_TEMPLATE_ID=
# Names of the data fields you tagged inside that template
CANVA_FIELD_HEADLINE=headline
CANVA_FIELD_BODY=body
CANVA_FIELD_CTA=cta

# --- Metricool ---
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# Comma-separated networks. Metricool keys: instagram, facebook, twitter, tiktok,
# youtube, gmb (Google Business Profile), linkedin.
METRICOOL_NETWORKS=twitter,facebook,instagram,gmb
METRICOOL_TIMEZONE=Europe/London

# --- Anthropic (Claude) — writes the post copy ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Notion (Marketing Content Queue database) ---
# Internal integration token; share the queue database with the integration.
NOTION_TOKEN=
NOTION_CONTENT_DB_ID=

# --- Media hosting (public repo the rendered PNGs are committed to) ---
MEDIA_REPO=jpyoung2011-ai/neuroaxis-social-assets
# PAT (or fine-grained token) with contents:write on MEDIA_REPO
MEDIA_REPO_TOKEN=

# --- Approval flow ---
# review = drafts land as Pending, publish only posts rows you set to Approved
# auto   = drafts land as Approved, publish posts them on the next run
# veto   = drafts land as Pending; publish posts any not Rejected after VETO_HOURS
APPROVAL_MODE=review
VETO_HOURS=48

# --- Batch / scheduling defaults (CLI flags override) ---
BATCH_COUNT=5
SCHEDULE_WEEKS=4
POSTS_PER_WEEK=5
# Funnel mix per week: TOFU=awareness, MOFU=consideration, BOFU=conversion/"ad"
FUNNEL_MIX=TOFU:3,MOFU:1,BOFU:1
SCHEDULE_SLOTS=10:00,13:00,17:00
INCLUDE_WEEKENDS=false

# --- Brand / content context ---
BRAND_NAME=NeuroAxis
BRAND_WEBSITE=neuroaxis-adhd.com
