# --- Canva Connect API (Developer Portal integration) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Filled in automatically by setup_canva_oauth.py the first time you run it
CANVA_REFRESH_TOKEN=
# The brand template you tagged for autofill (from canva.com/design/<ID>/...)
CANVA_BRAND_TEMPLATE_ID=
# Names of the data fields you tagged inside that template
CANVA_FIELD_HEADLINE=headline
CANVA_FIELD_BODY=body
CANVA_FIELD_CTA=cta

# --- Metricool ---
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# Comma-separated networks to post to, e.g. instagram,facebook
METRICOOL_NETWORKS=instagram,facebook
# Which weekday/time to schedule for, in ISO 8601, e.g. 2026-09-15T10:00:00
METRICOOL_DEFAULT_TIME=10:00:00
METRICOOL_TIMEZONE=Europe/London

# --- Anthropic (Claude) — writes the post copy ---
ANTHROPIC_API_KEY=

# --- Brand / content context ---
BRAND_NAME=NeuroAxis
BRAND_WEBSITE=neuroaxis-adhd.com
